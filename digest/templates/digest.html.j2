{% macro story_meta(story) %}
<div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#78716c;padding-bottom:6px;">
  <strong style="color:#44403c;" class="ink">{{ story.source }}</strong>
  {% if story.opinion %}&nbsp;<span class="accent" style="display:inline-block;padding:1px 7px;border:1px solid #d6a77a;border-radius:4px;color:#9a3412;font-size:10px;letter-spacing:1px;text-transform:uppercase;">Opinion</span>{% endif %}
  {% if story.author %}&nbsp;· {{ story.author }}{% endif %}
</div>
{% endmacro %}

{% macro feedback(story) %}
{% if digest.feedback_to %}
<div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#a8a29e;padding-top:10px;">
  <a href="{{ feedback_link(digest.feedback_to, 'more', story) }}" style="color:#78716c;text-decoration:none;">👍 More like this</a>
  &nbsp;&nbsp;·&nbsp;&nbsp;
  <a href="{{ feedback_link(digest.feedback_to, 'less', story) }}" style="color:#78716c;text-decoration:none;">👎 Less like this</a>
</div>
{% endif %}
{% endmacro %}

{% macro read_button(story) %}
<a class="btn" href="{{ story.url }}" style="display:inline-block;padding:8px 16px;border-radius:8px;background:#9a3412;color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:13px;font-weight:bold;text-decoration:none;">Read on {{ story.source }} →</a>
{% endmacro %}

{% macro card_heading(text, color='#9a3412') %}
<div class="accent" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2.5px;text-transform:uppercase;color:{{ color }};">{{ text }}</div>
{% endmacro %}

{% macro spacer() %}<tr><td style="height:18px;line-height:18px;font-size:0;">&nbsp;</td></tr>{% endmacro %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ digest.title }} · {{ digest.date.strftime('%A, %B %-d') }}</title>
<style>
  body { margin:0; padding:0; background:#f4efe6; }
  a { color:#9a3412; }
  .story-title a { color:#1c1917 !important; text-decoration:none; }
  .story-title a:hover { text-decoration:underline; }
  .btn:hover { background:#7c2d12 !important; }
  @media (max-width: 620px) {
    .container { width:100% !important; }
    .pad { padding-left:20px !important; padding-right:20px !important; }
    .masthead { font-size:34px !important; }
  }
  @media (prefers-color-scheme: dark) {
    body, .bg { background:#1c1917 !important; }
    .card { background:#292524 !important; }
    .brief { background:#2b2622 !important; border-color:#44403c !important; }
    .ink, .story-title a { color:#f5f5f4 !important; }
    .muted { color:#a8a29e !important; }
    .rule { border-color:#44403c !important; }
    .chip { background:#44403c !important; color:#f5f5f4 !important; }
    .accent { color:#fb923c !important; }
    .timeline { border-color:#57534e !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f4efe6;">
<!-- Preheader (inbox preview text) -->
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ digest.intro }}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4efe6;">
<tr><td align="center" style="padding:28px 12px;">

<table role="presentation" class="container" width="620" cellpadding="0" cellspacing="0" border="0" style="width:620px;max-width:620px;">

  <!-- Masthead -->
  <tr><td class="pad" align="center" style="padding:8px 32px 20px;">
    <div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#78716c;">
      {{ digest.date.strftime('%A · %B %-d, %Y') }} &nbsp;·&nbsp; {% if digest.reader_name %}{{ digest.reader_name }}'s edition{% else %}Your edition{% endif %}
    </div>
    <div class="masthead ink" style="font-family:Georgia,'Times New Roman',serif;font-size:42px;line-height:1.1;font-weight:bold;color:#1c1917;padding:10px 0 6px;">
      {{ digest.title }}
    </div>
    <div class="muted" style="font-family:Georgia,serif;font-style:italic;font-size:16px;line-height:1.5;color:#57534e;">
      {{ digest.intro }}
    </div>
  </td></tr>

  <!-- Jump links -->
  <tr><td align="center" style="padding:0 16px 22px;">
    <a href="#briefing" class="chip" style="display:inline-block;margin:3px;padding:7px 14px;border-radius:999px;background:#e7ded0;color:#44403c;font-family:Helvetica,Arial,sans-serif;font-size:13px;text-decoration:none;">⏱ 5-min briefing</a>
    {% if digest.developing %}
    <a href="#developing" class="chip" style="display:inline-block;margin:3px;padding:7px 14px;border-radius:999px;background:#e7ded0;color:#44403c;font-family:Helvetica,Arial,sans-serif;font-size:13px;text-decoration:none;">📈 Developing</a>
    {% endif %}
    {% for section in digest.sections if section.stories %}
    <a href="#{{ section.key }}" class="chip" style="display:inline-block;margin:3px;padding:7px 14px;border-radius:999px;background:#e7ded0;color:#44403c;font-family:Helvetica,Arial,sans-serif;font-size:13px;text-decoration:none;">{{ section.emoji }} {{ section.label }}</a>
    {% endfor %}
    <a href="#word" style="display:inline-block;margin:3px;padding:7px 14px;border-radius:999px;background:#1e293b;color:#fde68a;font-family:Helvetica,Arial,sans-serif;font-size:13px;text-decoration:none;">✦ Word of the day</a>
  </td></tr>

  <!-- 5-minute briefing -->
  {% if digest.briefing %}
  <tr><td class="brief" style="background:#fffbf5;border:2px solid #e7ded0;border-radius:14px;">
    <a name="briefing" id="briefing"></a>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="pad" style="padding:24px 32px 8px;">
        {{ card_heading('⏱ The 5-minute briefing') }}
        <div class="muted" style="font-family:Georgia,serif;font-style:italic;font-size:14px;color:#78716c;padding-top:4px;">Short on time? This is today in {{ digest.briefing|length }} lines.</div>
      </td></tr>
      {% for item in digest.briefing %}
      <tr><td class="pad" style="padding:10px 32px {{ '24px' if loop.last else '10px' }};">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td valign="top" width="34" style="width:34px;font-family:Georgia,serif;font-size:22px;font-weight:bold;color:#d6a77a;line-height:1.2;">{{ loop.index }}</td>
          <td valign="top" class="ink" style="font-family:Georgia,serif;font-size:16px;line-height:1.55;color:#292524;">
            {{ item.text }}
            <a href="{{ item.story.url }}" class="accent" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#9a3412;text-decoration:none;white-space:nowrap;">&nbsp;{{ item.story.source }} →</a>
          </td>
        </tr></table>
      </td></tr>
      {% endfor %}
    </table>
  </td></tr>
  {{ spacer() }}
  {% endif %}

  <!-- Developing stories -->
  {% if digest.developing %}
  <tr><td class="card" style="background:#ffffff;border-radius:14px;">
    <a name="developing" id="developing"></a>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="pad" style="padding:26px 32px 6px;">
        {{ card_heading('📈 Developing stories') }}
        <div class="muted" style="font-family:Georgia,serif;font-style:italic;font-size:14px;color:#78716c;padding-top:4px;">Stories you've seen here before, with what's changed.</div>
      </td></tr>
      {% for story in digest.developing %}
      <tr><td class="pad" style="padding:16px 32px {{ '26px' if loop.last else '16px' }};">
        {{ story_meta(story) }}
        <div class="story-title" style="font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:1.3;font-weight:bold;">
          <a href="{{ story.url }}" style="color:#1c1917;text-decoration:none;">{{ story.title }}</a>
          <span style="display:inline-block;vertical-align:middle;margin-left:6px;padding:2px 8px;border-radius:999px;background:#1e293b;color:#fde68a;font-family:Helvetica,Arial,sans-serif;font-size:10px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Day {{ story.thread|length + 1 }}</span>
        </div>
        {% if story.update or story.takeaway or story.summary %}
        <div class="ink" style="font-family:Georgia,serif;font-size:15px;line-height:1.6;color:#292524;padding-top:8px;">
          <span class="accent" style="color:#9a3412;font-weight:bold;">What's new —</span> {{ story.update or story.takeaway or story.summary }}
        </div>
        {% endif %}
        <!-- Timeline -->
        <div class="timeline" style="margin-top:12px;padding-left:14px;border-left:2px solid #e7ded0;">
          {% for past in story.thread %}
          <div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#78716c;padding:3px 0;">
            <strong>{{ past.date|short_date }}</strong> · <a href="{{ past.url }}" style="color:#57534e;" class="muted">{{ past.title }}</a> <span style="color:#a8a29e;">({{ past.source }})</span>
          </div>
          {% endfor %}
          <div class="accent" style="font-family:Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#9a3412;padding:3px 0;"><strong>Today</strong> · {{ story.source }}</div>
        </div>
        <div style="padding-top:12px;">{{ read_button(story) }}</div>
        {{ feedback(story) }}
        {% if not loop.last %}<div class="rule" style="border-bottom:1px solid #eee7dc;padding-top:20px;"></div>{% endif %}
      </td></tr>
      {% endfor %}
    </table>
  </td></tr>
  {{ spacer() }}
  {% endif %}

  {% for section in digest.sections if section.stories %}
  <!-- Section: {{ section.label }} -->
  <tr><td class="card" style="background:#ffffff;border-radius:14px;padding:0;">
    <a name="{{ section.key }}" id="{{ section.key }}"></a>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="pad" style="padding:26px 32px 6px;">
        {{ card_heading(section.emoji ~ '  ' ~ section.label) }}
      </td></tr>
      {% for story in section.stories %}
      <tr><td class="pad" style="padding:16px 32px {{ '26px' if loop.last else '16px' }};">
        {{ story_meta(story) }}
        <div class="story-title" style="font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:1.3;font-weight:bold;">
          <a href="{{ story.url }}" style="color:#1c1917;text-decoration:none;">{{ story.title }}</a>
        </div>
        {% if story.takeaway %}
        <div class="ink" style="font-family:Georgia,serif;font-size:15px;line-height:1.6;color:#292524;padding-top:8px;">
          <span class="accent" style="color:#9a3412;font-weight:bold;">The gist —</span> {{ story.takeaway }}
        </div>
        {% elif story.summary %}
        <div class="muted" style="font-family:Georgia,serif;font-size:15px;line-height:1.6;color:#57534e;padding-top:8px;">{{ story.summary }}</div>
        {% endif %}
        <div style="padding-top:12px;">{{ read_button(story) }}</div>
        {{ feedback(story) }}
        {% if not loop.last %}<div class="rule" style="border-bottom:1px solid #eee7dc;padding-top:20px;"></div>{% endif %}
      </td></tr>
      {% endfor %}
    </table>
  </td></tr>
  {{ spacer() }}
  {% endfor %}

  {% if digest.word %}
  <!-- Word of the day -->
  <tr><td style="background:#1e293b;border-radius:14px;">
    <a name="word" id="word"></a>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="pad" style="padding:28px 32px;">
        <div style="font-family:Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;letter-spacing:2.5px;text-transform:uppercase;color:#fbbf24;">✦ Word of the day</div>
        {% if digest.word.theme %}
        <div style="font-family:Georgia,serif;font-style:italic;font-size:14px;color:#94a3b8;padding-top:6px;">{{ digest.word.theme }}</div>
        {% endif %}
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:38px;line-height:1.2;font-weight:bold;color:#fefce8;padding-top:10px;">{{ digest.word.word }}</div>
        <div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#cbd5e1;padding-top:4px;">
          <em>{{ digest.word.part_of_speech }}</em>{% if digest.word.pronunciation %} &nbsp;·&nbsp; /{{ digest.word.pronunciation }}/{% endif %}
        </div>
        <div style="font-family:Georgia,serif;font-size:17px;line-height:1.55;color:#f8fafc;padding-top:14px;">{{ digest.word.definition }}</div>
        {% if digest.word.example %}
        <div style="font-family:Georgia,serif;font-style:italic;font-size:15px;line-height:1.55;color:#e2e8f0;padding:12px 0 0 14px;border-left:3px solid #fbbf24;margin-top:14px;">“{{ digest.word.example }}”</div>
        {% endif %}
        {% if digest.word.origin %}
        <div style="font-family:Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#94a3b8;padding-top:14px;"><strong style="color:#cbd5e1;">Origin:</strong> {{ digest.word.origin }}</div>
        {% endif %}
        <div style="padding-top:18px;">
          <a href="https://www.merriam-webster.com/dictionary/{{ digest.word.word | urlencode }}" style="display:inline-block;padding:8px 16px;border-radius:8px;background:#fbbf24;color:#1e293b;font-family:Helvetica,Arial,sans-serif;font-size:13px;font-weight:bold;text-decoration:none;">Hear it pronounced →</a>
          {% if digest.word.related_url %}
          &nbsp;<a href="{{ digest.word.related_url }}" style="display:inline-block;padding:8px 16px;border-radius:8px;border:1px solid #fbbf24;color:#fde68a;font-family:Helvetica,Arial,sans-serif;font-size:13px;font-weight:bold;text-decoration:none;">See it in today's news →</a>
          {% endif %}
        </div>
        {% if digest.word_bank %}
        <div style="margin-top:22px;padding-top:16px;border-top:1px solid #334155;">
          <div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#94a3b8;padding-bottom:6px;">Also in today's articles</div>
          {% for w in digest.word_bank %}
          <div style="font-family:Georgia,serif;font-size:15px;line-height:1.5;color:#e2e8f0;padding:4px 0;">
            <strong style="color:#fde68a;">{{ w.word }}</strong> <em style="color:#94a3b8;">{{ w.part_of_speech }}</em> — {{ w.definition }}
            {% if w.related_url %}<a href="{{ w.related_url }}" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#fbbf24;text-decoration:none;">&nbsp;in context →</a>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
        <div style="font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#94a3b8;padding-top:16px;">Challenge: use <strong style="color:#fde68a;">{{ digest.word.word }}</strong> in a conversation today.</div>
      </td></tr>
    </table>
  </td></tr>
  {{ spacer() }}
  {% endif %}

  <!-- Your edition -->
  <tr><td class="card" style="background:#ffffff;border-radius:14px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="pad" style="padding:22px 32px;">
        {{ card_heading('🎯 Your edition') }}
        {% if digest.tuning %}
        <div class="ink" style="font-family:Georgia,serif;font-size:15px;line-height:1.6;color:#292524;padding-top:8px;">Tuned from your feedback: {{ digest.tuning | join(' · ') }}.</div>
        {% else %}
        <div class="ink" style="font-family:Georgia,serif;font-size:15px;line-height:1.6;color:#292524;padding-top:8px;">This edition learns what you like. Tap 👍 or 👎 under any story and send the email that opens; tomorrow's picks will adjust.</div>
        {% endif %}
      </td></tr>
    </table>
  </td></tr>

  {% if digest.flagged_feeds %}
  <!-- Feed health -->
  <tr><td class="pad" style="padding:18px 32px 0;">
    <div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#78716c;background:#fef3c7;border-radius:10px;padding:12px 16px;">
      <strong style="color:#92400e;">⚠ Feed check:</strong>
      {% for f in digest.flagged_feeds %}<a href="{{ f.url }}" style="color:#92400e;">{{ f.name }}</a> (empty {{ f.days }} days){% if not loop.last %}, {% endif %}{% endfor %}.
      {% if settings_url %}<a href="{{ settings_url }}" style="color:#92400e;">Replace in config.yaml</a>{% else %}Consider replacing in config.yaml.{% endif %}
    </div>
  </td></tr>
  {% endif %}

  <!-- Footer -->
  <tr><td class="pad" align="center" style="padding:26px 32px 8px;">
    <div class="muted" style="font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#78716c;">
      {{ digest.story_count }} stories from {{ digest.source_count }} publications{% if digest.curated_by_ai %} · AI-curated{% endif %}<br>
      {% if settings_url %}<a href="{{ settings_url }}" style="color:#9a3412;">Tune your sections &amp; sources</a>{% endif %}
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
